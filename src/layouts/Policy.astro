---
/** Layout for plain Markdown pages (privacy policies and the like). */
import Article from "./Article.astro";

interface Props {
  frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props;
---

<Article title={frontmatter.title} description={frontmatter.description}>
  <div class="space-y-4 leading-7 [&_a]:link [&_code]:rounded-sm [&_code]:bg-wash [&_code]:px-1 [&_code]:text-[0.9em] [&_h1]:mb-8 [&_h1]:text-3xl [&_h1]:font-bold [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_hr]:my-10 [&_hr]:border-rule [&_ol]:ml-6 [&_ol]:list-decimal [&_ul]:ml-6 [&_ul]:list-disc">
    <slot />
  </div>
</Article>
