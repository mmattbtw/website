---
import UseList from "../components/UseList.astro";
import { sections, updated } from "../data/uses";
import Article from "../layouts/Article.astro";
---

<Article title="/uses" description="the hardware and software i use.">
  <h1 class="text-3xl font-bold">/uses</h1>
  <p class="text-muted">last updated: {updated}</p>

  {sections.map((section) => (
    <section class="mt-10">
      <h2 class="mb-2 text-2xl font-bold">{section.heading}</h2>
      <UseList items={section.items} />
    </section>
  ))}

  <p class="mt-10">
    the above links <b>are</b> affiliate links.
  </p>
</Article>
